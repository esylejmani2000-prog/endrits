{
  "name": "endrits",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/images.mjs",
    "dev": "npm run images && vite",
    "build": "npm run images && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "npm run images && tsc --noEmit",
    "lint": "oxlint",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "description": "Personal site and product portfolio of Endrit Sylejmani (endrits.com).",
  "engines": {
    "node": ">=22.18"
  }
}
